# =============================================================================
# Connecteur MCP SAM — configuration
# Copier vers .env (serveur Node) ou .dev.vars (wrangler dev). Ne jamais versionner les vraies valeurs.
# Si une valeur contient # ou un espace, l'entourer de guillemets : SAM_ACCOUNT_1_PASSWORD="mot#de passe"
# En production (Cloudflare) : npx wrangler secret put <NOM>
# =============================================================================

# --- API SAM --------------------------------------------------------------------
SAM_API_BASE_URL=https://eicajdaswdgfwgmaxene.supabase.co/functions/v1
# true = API SAM simulée (dev/tests, données fictives) ; false = vraie API
SAM_MOCK=false
# disabled (lecture seule) | confirm (aperçu + confirmation explicite, défaut) | direct
SAM_WRITE_MODE=disabled
# true = active l'outil send_email (envoi via l'expéditeur du CRM : to, subject, html)
SAM_SEND_EMAIL=false
# Délai max de chaque appel SAM, en ms (1000-60000)
SAM_REQUEST_TIMEOUT_MS=15000

# --- Comptes SAM (un bloc par personne, numérotés à partir de 1, 10 max) ------------
# EMAIL / PASSWORD          : identifiants SAM de la personne (compte avec le rôle SAM) — secrets
# CONNECTOR_PASSWORD        : mot de passe inventé, >= 12 caractères, différent pour chaque compte
#                             et différent du mot de passe SAM. La personne le saisit quand elle
#                             connecte Claude.ai : c'est lui qui désigne son compte SAM — secret
# STATIC_TOKEN (optionnel)  : jeton >= 32 caractères pour les tests / Claude Code (npm run secret:generate) — secret
# LABEL (optionnel)         : nom affiché dans les logs et indiqué à Claude

SAM_ACCOUNT_1_LABEL=
SAM_ACCOUNT_1_EMAIL=
SAM_ACCOUNT_1_PASSWORD=
SAM_ACCOUNT_1_CONNECTOR_PASSWORD=
SAM_ACCOUNT_1_STATIC_TOKEN=

SAM_ACCOUNT_2_LABEL=
SAM_ACCOUNT_2_EMAIL=
SAM_ACCOUNT_2_PASSWORD=
SAM_ACCOUNT_2_CONNECTOR_PASSWORD=
SAM_ACCOUNT_2_STATIC_TOKEN=

# Clé publique Supabase du site SAM (celle que le navigateur reçoit sur https://sam.classicall.fr).
# Active les fonctions du site : modèles d'email, historique, dépôt de fichiers, comptes commerciaux, lecture des commentaires.
SAM_SUPABASE_ANON_KEY=

# --- Protection du serveur MCP ------------------------------------------------------
# Clé de signature des jetons, >= 32 caractères (npm run secret:generate). La changer révoque tous les accès — secret
MCP_AUTH_SECRET=
# URL publique une fois déployé (vide en local), ex. https://sam-mcp.<sous-domaine>.workers.dev
MCP_PUBLIC_URL=
# Hôtes autorisés comme redirect_uri OAuth
OAUTH_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1

# --- Divers -------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# Serveur Node uniquement
PORT=8787
HOST=127.0.0.1

# Mode un seul compte (ancien format, toujours accepté, à ne pas mélanger avec SAM_ACCOUNT_<N>_*) :
# SAM_EMAIL= / SAM_PASSWORD= / MCP_OWNER_PASSWORD= / MCP_STATIC_TOKEN=
